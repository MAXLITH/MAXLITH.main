# =====================================================================
# MAXLITH Environment Configuration Example
# AI-Powered Indian Equities (NSE/BSE) Paper Trading Platform
# =====================================================================

NODE_ENV=development
PORT=3000

# Authentication Secret (use a unique, long random value outside development)
# ---------------------------------------------------------------------
# Database & Cache Configuration
# ---------------------------------------------------------------------
DATABASE_PATH=./data/maxlith.db
# Optional PostgreSQL connection URL if migrating from SQLite
DATABASE_URL=

# Normalized market-data adapter (server-only; leave blank until a licensed
# provider or MAXLITH provider adapter is configured).
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
MARKET_DATA_WS_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MARKET_WS_URL=
MARKET_STREAM_JWT_SECRET=
MARKET_STREAM_ALLOWED_ORIGINS=https://your-app.example

# Optional Redis Cache (falls back to high-performance in-memory cache if omitted)
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------
# Authentication & Security (JWT httpOnly Cookies)
# ---------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret

# Admin Initial Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Financial Settings
# ---------------------------------------------------------------------
# Financial & Paper Trading Parameters
# ---------------------------------------------------------------------
INITIAL_VIRTUAL_CAPITAL=1000000
DEFAULT_SLIPPAGE_BPS=5
MIS_MARGIN_MULTIPLIER=5

# Database
DATABASE_PATH=./data/maxlith.db
# Regulatory Charges Model Overrides
BROKERAGE_PCT=0.0003
BROKERAGE_CAP=20
DELIVERY_BROKERAGE=false
STT_DELIVERY_PCT=0.001
STT_INTRADAY_SELL_PCT=0.00025
EXCHANGE_TXN_PCT=0.0000297
SEBI_PCT=0.000001
STAMP_DELIVERY_PCT=0.00015
STAMP_INTRADAY_PCT=0.00003
GST_PCT=0.18

# Market Data API Providers (optional; the professional terminal uses only
# the normalized provider contract above)
# ---------------------------------------------------------------------
# AI Ecosystem Configuration (Anthropic Claude with Tool Use)
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
AI_DISCLAIMER="Paper trading / educational, not investment advice."

# ---------------------------------------------------------------------
# Optional keys used by legacy integrations; these do not enable the
# professional terminal market-data adapter.
# ---------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# AI Services Configuration
OPENAI_API_KEY=
GEMINI_API_KEY=
TWELVE_DATA_API_KEY=
UPSTOX_API_KEY=
ANGEL_ONE_API_KEY=
ZERODHA_KITE_API_KEY=
