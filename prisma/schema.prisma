// Prisma Schema for MAXLITH - Indian Equities AI Paper Trading Platform
// Defines complete models for PostgreSQL / SQLite production & paper trading

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum OrderType {
  MARKET
  LIMIT
  SL
  SL_M
}

enum OrderSide {
  BUY
  SELL
}

enum ProductType {
  CNC // Cash and Carry (Delivery)
  MIS // Margin Intraday Square-off
}

enum OrderStatus {
  PENDING
  TRIGGER_PENDING
  COMPLETE
  CANCELLED
  REJECTED
}

enum AlertCondition {
  ABOVE
  BELOW
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String              @map("password_hash")
  fullName           String              @map("full_name")
  role               Role                @default(USER)
  virtualCash        Float               @default(1000000.0) @map("virtual_cash")
  initialCapital     Float               @default(1000000.0) @map("initial_capital")
  blockedMargin      Float               @default(0.0) @map("blocked_margin")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  sessions           Session[]
  accounts           Account[]
  ledgerEntries      LedgerEntry[]
  watchlists         Watchlist[]
  orders             Order[]
  trades             Trade[]
  positions          Position[]
  holdings           Holding[]
  portfolioSnapshots PortfolioSnapshot[]
  alerts             Alert[]
  notifications      Notification[]
  chatThreads        ChatThread[]
  agentRuns          AgentRun[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  accountNumber  String   @unique @map("account_number")
  balancePaise   BigInt   @default(100000000) @map("balance_paise") // Integer paise
  currency       String   @default("INR")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model LedgerEntry {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  entryType    String   @map("entry_type") // DEPOSIT, WITHDRAWAL, TRADE_BUY, TRADE_SELL, BROKERAGE, TAX_STT, CHARGES_GST, RESET
  amountPaise  BigInt   @map("amount_paise") // Signed integer paise (+ credit, - debit)
  balanceAfter BigInt   @map("balance_after")
  referenceId  String?  @map("reference_id")
  description  String
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("ledger_entries")
}

model Instrument {
  symbol        String          @id
  name          String
  exchange      String          @default("NSE")
  sector        String?
  assetType     String          @default("EQUITY") @map("asset_type")
  currentPrice  Float           @map("current_price")
  previousClose Float           @map("previous_close")
  openPrice     Float           @map("open_price")
  highPrice     Float           @map("high_price")
  lowPrice      Float           @map("low_price")
  change        Float           @default(0.0)
  percentChange Float           @default(0.0) @map("percent_change")
  volume        BigInt          @default(0)
  high52w       Float?          @map("high_52w")
  low52w        Float?          @map("low_52w")
  marketCap     Float?          @map("market_cap")
  peRatio       Float?          @map("pe_ratio")
  pbRatio       Float?          @map("pb_ratio")
  tickSize      Float           @default(0.05) @map("tick_size")
  lotSize       Int             @default(1) @map("lot_size")
  circuitLimit  Float?          @map("circuit_limit")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  candles       Candle[]
  quoteSnapshots QuoteSnapshot[]
  orders        Order[]
  trades        Trade[]
  positions     Position[]
  holdings      Holding[]
  watchlistItems WatchlistItem[]

  @@index([sector])
  @@index([exchange])
  @@map("instruments")
}

model QuoteSnapshot {
  id         String     @id @default(cuid())
  symbol     String
  ltp        Float
  bidPrice   Float?     @map("bid_price")
  askPrice   Float?     @map("ask_price")
  volume     BigInt     @default(0)
  isFallback Boolean    @default(false) @map("is_fallback")
  createdAt  DateTime   @default(now()) @map("created_at")

  instrument Instrument @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol])
  @@index([createdAt])
  @@map("quote_snapshots")
}

model Candle {
  id        String     @id @default(cuid())
  symbol    String
  timestamp DateTime
  timeframe String     @default("1D") // 1D, 1W, 1M, 6M, 1Y, 5Y
  open      Float
  high      Float
  low       Float
  close     Float
  volume    BigInt

  instrument Instrument @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timestamp])
  @@map("price_history")
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  name      String
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String     @id @default(cuid())
  watchlistId String     @map("watchlist_id")
  symbol      String
  sortOrder   Int        @default(0) @map("sort_order")
  addedAt     DateTime   @default(now()) @map("added_at")

  watchlist   Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrument  Instrument @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([symbol])
  @@map("watchlist_items")
}

model Order {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  symbol         String
  side           OrderSide
  orderType      OrderType   @map("order_type")
  productType    ProductType @default(CNC) @map("product_type")
  quantity       Int
  price          Float
  triggerPrice   Float?      @map("trigger_price")
  status         OrderStatus @default(PENDING)
  filledQuantity Int         @default(0) @map("filled_quantity")
  avgFillPrice   Float?      @map("avg_fill_price")
  rejectionReason String?    @map("rejection_reason")
  idempotencyKey String?     @unique @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument     Instrument  @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  trades         Trade[]

  @@index([userId])
  @@index([symbol])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Trade {
  id              String      @id @default(cuid())
  orderId         String      @map("order_id")
  userId          String      @map("user_id")
  symbol          String
  side            OrderSide
  productType     ProductType @default(CNC) @map("product_type")
  quantity        Int
  executionPrice  Float       @map("execution_price")
  turnoverPaise   BigInt      @map("turnover_paise")
  brokeragePaise  BigInt      @default(0) @map("brokerage_paise")
  sttPaise        BigInt      @default(0) @map("stt_paise")
  exchangeTxnPaise BigInt     @default(0) @map("exchange_txn_paise")
  sebiFeesPaise   BigInt      @default(0) @map("sebi_fees_paise")
  stampDutyPaise  BigInt      @default(0) @map("stamp_duty_paise")
  gstPaise        BigInt      @default(0) @map("gst_paise")
  totalChargesPaise BigInt    @default(0) @map("total_charges_paise")
  createdAt       DateTime    @default(now()) @map("created_at")

  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument      Instrument  @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([userId])
  @@index([symbol])
  @@index([createdAt])
  @@map("trades")
}

model Position {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  symbol      String
  productType ProductType @default(MIS) @map("product_type")
  quantity    Int
  buyAvgPrice Float       @map("buy_avg_price")
  sellAvgPrice Float?     @map("sell_avg_price")
  realizedPnl Float       @default(0.0) @map("realized_pnl")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument  Instrument  @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([userId, symbol, productType])
  @@index([userId])
  @@index([symbol])
  @@map("positions")
}

model Holding {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  symbol      String
  quantity    Int
  avgPrice    Float      @map("avg_price")
  invested    Float
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument  Instrument @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
  @@index([symbol])
  @@map("holdings")
}

model PortfolioSnapshot {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  snapshotDate   DateTime @map("snapshot_date")
  totalValue     Float    @map("total_value")
  investedValue  Float    @map("invested_value")
  cashBalance    Float    @map("cash_balance")
  dayPnl         Float    @map("day_pnl")
  overallPnl     Float    @map("overall_pnl")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId])
  @@index([createdAt])
  @@map("portfolio_snapshots")
}

model Alert {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  symbol      String
  condition   AlertCondition
  targetValue Float          @map("target_value")
  isTriggered Boolean        @default(false) @map("is_triggered")
  triggeredAt DateTime?      @map("triggered_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([symbol])
  @@index([isTriggered])
  @@map("alerts")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model NewsArticle {
  id             String    @id @default(cuid())
  title          String
  summary        String
  source         String
  url            String?
  sentiment      Sentiment @default(NEUTRAL)
  relatedSymbols String?   @map("related_symbols") // Comma-separated symbols
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("news")
}

model AgentRun {
  id              String   @id @default(cuid())
  userId          String?  @map("user_id")
  agentName       String   @map("agent_name")
  symbol          String?
  tokensUsed      Int      @default(0) @map("tokens_used")
  costUsd         Float    @default(0.0) @map("cost_usd")
  executionTimeMs Int      @default(0) @map("execution_time_ms")
  output          String
  createdAt       DateTime @default(now()) @map("created_at")

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agentName])
  @@index([symbol])
  @@index([createdAt])
  @@map("ai_agent_runs")
}

model ChatThread {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  title     String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model ChatMessage {
  id             String     @id @default(cuid())
  conversationId String     @map("conversation_id")
  sender         String     // USER or ASSISTANT
  content        String
  agentData      String?    @map("agent_data")
  createdAt      DateTime   @default(now()) @map("created_at")

  thread         ChatThread @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_messages")
}

model MarketHoliday {
  id          String   @id @default(cuid())
  holidayDate DateTime @unique @map("holiday_date")
  description String
  exchange    String   @default("NSE")
  tradingOpen Boolean  @default(false) @map("trading_open")

  @@map("market_holidays")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model TelemetryEvent {
  id        String   @id @default(cuid())
  kind      String   // LATENCY, ERROR_RATE, API_CALL, AGENT_RUN
  metric    String
  value     Float
  meta      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind])
  @@index([createdAt])
  @@map("telemetry_events")
}
