# MAXLITH V2 FastAPI Market Data Service Configuration

# Service Server
HOST=0.0.0.0
PORT=4100
ENVIRONMENT=production
LOG_LEVEL=INFO

# Official Upstox V3 Market Data Feed Credentials
# Obtain from https://developer.upstox.com/
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_FEED_MODE=full

# JWT Authentication for WebSocket Clients (Must match Next.js MARKET_STREAM_JWT_SECRET)
MARKET_STREAM_JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
MARKET_STREAM_DEV_AUTH=false

# Allowed Origins (CORS & WebSocket origin check, comma-separated)
MAXLITH_ALLOWED_ORIGINS=https://maxlith-main.vercel.app,http://localhost:3000

# Cache & Upstream Configuration
QUOTE_STALE_THRESHOLD_SECONDS=30.0
DEFAULT_WATCHLIST=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank,NSE_EQ|INE002A01018,NSE_EQ|INE467B01029,NSE_EQ|INE009A01021,NSE_EQ|INE040A01034

# Optional Redis URL for multi-instance scaling (leave blank for in-memory)
# REDIS_URL=redis://localhost:6379/0

